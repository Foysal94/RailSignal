{
  "name": "railsignal",
  "version": "0.1.0",
  "private": true,
  "description": "RailSignal - London Weekend Closure Radar",
  "workspaces": [
    "packages/shared",
    "backend",
    "client"
  ],
  "scripts": {
    "build:shared": "npm run build --workspace=@railsignal/shared",
    "build:backend": "npm run build --workspace=@railsignal/backend",
    "build:client": "npm run build --workspace=@railsignal/client --if-present",
    "build": "npm run build:shared && npm run build:backend && npm run build:client",
    "dev": "npm run build:shared && npm run dev --workspace=@railsignal/backend",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15"
  }
}
