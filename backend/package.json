{
  "name": "@railsignal/backend",
  "version": "0.1.0",
  "type": "module",
  "description": "RailSignal Fastify HTTP API and BullMQ worker host",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "job:sync-disruptions": "node dist/jobs/syncDisruptionsRunner.js",
    "job:sync-disruptions:dev": "tsx src/jobs/syncDisruptionsRunner.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "email:dev": "email dev --dir src/email/templates",
    "prisma:generate": "prisma generate",
    "prisma:prep-prod": "node -e \"const fs = require('fs'); const file = 'prisma/schema.prisma'; const content = fs.readFileSync(file, 'utf8'); fs.writeFileSync(file, content.replace(/provider\\s*=\\s*\\\"sqlite\\\"/, 'provider = \\\"postgresql\\\"'));\""
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@fastify/cors": "^11.3.1",
    "@prisma/client": "^6.19.3",
    "@railsignal/shared": "*",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@sinclair/typebox": "^0.34.46",
    "bullmq": "^6.3.14",
    "cockatiel": "^4.0.0",
    "date-fns": "^4.4.0",
    "fastify": "^5.2.1",
    "ioredis": "^6.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.32.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "prisma": "^6.19.3",
    "react-email": "^6.11.1",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
