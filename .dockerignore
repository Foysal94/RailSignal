# Monorepo Docker ignore rules
node_modules
*/node_modules
packages/*/node_modules
backend/node_modules
client/node_modules

# Build artifacts
dist
*/dist
packages/*/dist
backend/dist
client/dist

# Version control and tooling
.git
.github
.agents
.husky
graphify-out
coverage

# Local databases and runtime state
*.db
*.db-journal
*.sqlite
*.sqlite3
*.log
npm-debug.log*

# Environment and secrets
.env
.env.*
!.env.example
